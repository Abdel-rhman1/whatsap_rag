APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rag_db
DB_USERNAME=rag_user
DB_PASSWORD=rag_pass

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Multi-Tenant RAG Config
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434

EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:0.5b

# WhatsApp config
WHATSAPP_SECRET=some_random_secret
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3000

# Per-tenant Collection vs Payload filter (default: payload)
QDRANT_TENANT_STRATEGY=payload

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

